---
apiVersion: v1
kind: Secret
metadata:
  name: {{ ocp4_workload_prepare_environment_vm_secret_name }}
  namespace: {{ ocp4_workload_prepare_environment_vm_namespace }}
type: Opaque
stringData:
  satellite-url: "{{ ocp4_workload_prepare_environment_vm_satellite_url | trim }}"
  satellite-org: "{{ ocp4_workload_prepare_environment_vm_satellite_org | trim }}"
  satellite-activationkey: "{{ ocp4_workload_prepare_environment_vm_satellite_activationkey | trim }}"
  vm-user: "{{ ocp4_workload_prepare_environment_vm_user | trim }}"
  vm-password: "{{ ocp4_workload_prepare_environment_vm_password | trim }}"
  userdata: |
    #cloud-config
    users:
      - name: {{ ocp4_workload_prepare_environment_vm_user | trim }}
        groups: wheel
        sudo: ALL=(ALL) NOPASSWD:ALL
        lock_passwd: false
        shell: /bin/bash
        plain_text_passwd: {{ ocp4_workload_prepare_environment_vm_password | trim }}
    chpasswd:
      expire: false
    ssh_pwauth: true
    runcmd:
{% if ocp4_workload_prepare_environment_vm_satellite_url | trim | length > 0 %}
      - curl -k -o /tmp/katello-ca-consumer-latest.noarch.rpm https://{{ ocp4_workload_prepare_environment_vm_satellite_url | trim }}/pub/katello-ca-consumer-latest.noarch.rpm
      - rpm -Uvh /tmp/katello-ca-consumer-latest.noarch.rpm
      - |
        subscription-manager register \
          --activationkey="{{ ocp4_workload_prepare_environment_vm_satellite_activationkey | trim }}" \
          --org="{{ ocp4_workload_prepare_environment_vm_satellite_org | trim }}" \
          --name="{{ ocp4_workload_prepare_environment_vm_name | trim }}-{{ guid }}" \
          --force
{% endif %}
      - echo "Subscription credentials applied"
