---
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: {{ ocp4_workload_prepare_environment_vm_name }}
  namespace: {{ ocp4_workload_prepare_environment_vm_namespace }}
  labels:
    app: {{ ocp4_workload_prepare_environment_vm_name }}
spec:
  dataVolumeTemplates:
  - metadata:
      name: {{ ocp4_workload_prepare_environment_vm_name }}-volume
    spec:
      sourceRef:
        kind: DataSource
        name: {{ ocp4_workload_prepare_environment_vm_datasource_name }}
        namespace: {{ ocp4_workload_prepare_environment_vm_datasource_namespace }}
      storage:
        resources:
          requests:
            storage: {{ ocp4_workload_prepare_environment_vm_disksize }}
  runStrategy: {{ ocp4_workload_prepare_environment_vm_run_strategy }}
  template:
    metadata:
      labels:
        network.kubevirt.io/headlessService: headless
        kubevirt.io/domain: {{ ocp4_workload_prepare_environment_vm_name }}
        kubevirt.io/size: small
    spec:
      architecture: amd64
      domain:
        cpu:
          cores: {{ ocp4_workload_prepare_environment_vm_cpu_cores | int }}
          sockets: {{ ocp4_workload_prepare_environment_vm_cpu_sockets | int }}
          threads: {{ ocp4_workload_prepare_environment_vm_cpu_threads | int }}
        memory:
          guest: {{ ocp4_workload_prepare_environment_vm_memory_guest }}
        devices:
          autoattachVSOCK: true
          disks:
          - name: rootdisk
            bootOrder: 1
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
            - masquerade: {}
              model: virtio
              name: default
          rng: {}
        features:
          acpi: {}
          smm:
            enabled: true
        firmware:
          bootloader:
            efi: {}
        machine:
          type: pc-q35-rhel9.6.0
        resources: {}
      networks:
        - name: default
          pod: {}
      subdomain: headless
      volumes:
      - name: rootdisk
        dataVolume:
          name: {{ ocp4_workload_prepare_environment_vm_name }}-volume
      - name: cloudinitdisk
        cloudInitNoCloud:
          secretRef:
            name: {{ ocp4_workload_prepare_environment_vm_secret_name }}
